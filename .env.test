# Route tests run against this separate database, never the dev database. Created and seeded by vitest.global-setup.ts.
DATABASE_URL=postgresql://youleap:youleap@localhost:5432/youleap_test
REDIS_URL=redis://localhost:6379/1
APP_URL=http://localhost:3000
# Admin user the seed creates in the test database. Test-only value, not a secret.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@goodsmith.test
# Test-only signing secret, not used anywhere else.
JWT_SECRET=test-jwt-secret-for-vitest-only-0123456789
