generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Collection {
  id       String    @id
  title    String
  handle   String    @unique
  products Product[]

  @@map("collections")
}

model Product {
  id           String          @id
  title        String
  handle       String          @unique
  description  String?
  thumbnail    String?
  collectionId String?         @map("collection_id")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  // Cheapest variant price (minor units). Prisma can't order by MIN() over a relation, so the seed stores it for sorting by price.
  minPrice     Int             @map("min_price")
  collection   Collection?     @relation(fields: [collectionId], references: [id], onDelete: NoAction)
  images       ProductImage[]
  tags         ProductTag[]
  options      ProductOption[]
  variants     Variant[]

  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId String  @map("product_id")
  url       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Tag {
  id       Int          @id @default(autoincrement())
  value    String       @unique
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String  @map("product_id")
  tagId     Int     @map("tag_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model ProductOption {
  id        String               @id
  productId String               @map("product_id")
  title     String
  // Not in the original design: variant titles list option values in this order, so it must be stored.
  position  Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@map("product_options")
}

model ProductOptionValue {
  id       Int                  @id @default(autoincrement())
  optionId String               @map("option_id")
  value    String
  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model Variant {
  id                String               @id
  productId         String               @map("product_id")
  title             String
  sku               String               @unique
  inventoryQuantity Int                  @default(0) @map("inventory_quantity")
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues      VariantOptionValue[]
  prices            VariantPrice[]

  @@map("variants")
}

model VariantOptionValue {
  variantId     String             @map("variant_id")
  optionValueId Int                @map("option_value_id")
  variant       Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

model VariantPrice {
  id           Int     @id @default(autoincrement())
  variantId    String  @map("variant_id")
  // Minor units (agorot): 29900 means 299.00.
  amount       Int
  currencyCode String  @map("currency_code") @db.Char(3)
  variant      Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, currencyCode])
  @@map("variant_prices")
}

model User {
  id           Int      @id @default(autoincrement())
  userName     String   @unique @map("user_name")
  passwordHash String   @map("password_hash")
  email        String?  @unique
  orders       Order[]
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @map("order_number") // e.g. "GS-10482"
  userId      Int    @map("user_id")
  user        User   @relation(fields: [userId], references: [id])

  // Shipping address
  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  address1   String  @map("address_1")
  address2   String? @map("address_2")
  city       String
  postalCode String  @map("postal_code")
  country    String  @db.Char(2) // "IL", "US", ...
  phone      String?

  // Totals (minor units, e.g. 29900 = ₪299.00)
  currencyCode  String @default("ILS") @map("currency_code")
  subtotal      Int
  shippingTotal Int    @default(0) @map("shipping_total")
  total         Int

  status    OrderStatus @default(PENDING)
  items     OrderItem[]
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@map("orders")
}

// Items are snapshots with no foreign keys to the catalog, so reseeding products never changes or deletes order history.
model OrderItem {
  id           String @id @default(cuid())
  orderId      String @map("order_id")
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String @map("product_id") // "prod_01"
  variantId    String @map("variant_id") // "var_01a"
  title        String // snapshot: "Classic Wireless Headphones"
  variantTitle String @map("variant_title") // snapshot: "Black"
  sku          String // snapshot: "HP-BLK-01"
  unitPrice    Int    @map("unit_price") // 29900 = ₪299.00
  quantity     Int

  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  CANCELLED
}
