POSTGRES_USER=youleap
POSTGRES_PASSWORD=youleap
POSTGRES_DB=youleap
POSTGRES_PORT=5432
APP_PORT=3000

DATABASE_URL=postgresql://youleap:youleap@localhost:5432/youleap
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000

# Admin user created by `pnpm prisma db seed` (and on every Docker start). Only the seed reads these.
# admin / admin is a local-dev default; use a strong password anywhere else.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@goodsmith.test

# Signs the 1-hour sign-in tokens. Use a long random value, e.g. `openssl rand -base64 32`.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
